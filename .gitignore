# Build artifacts — the `mst` binary and compiled test binaries
/mst
/mst.exe
*.exe
*.test
/dist/
/build/

# Go — keep go.mod / go.sum committed; ignore local workspace + coverage output
go.work
go.work.sum
coverage.txt
coverage.out
coverage.html

# Secrets / environment — mst reads engine API keys from env; never commit keys
.env
.env.*
!.env.example

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python extension build artifacts (the Cython source _mst.pyx IS committed;
# the generated C / header / .so / bytecode are build outputs)
python/build/
__pycache__/
*.pyc
python/src/mst/_mst.c
python/src/mst/_mst.h
python/src/mst/_mst*.so

# cgo module: stray binary from a plain `go build` (the c-shared artifact is
# built into python/src/mst/ by the publish workflow)
/cgo/cgo

# Local working/process files — internal only, never shipped
/AGENTS.md
/TASKS.md
/PROGRESS.md
/DECISIONS.md


